# ==============================================================================
# 1. SUNUCU & DOCKER ÇALIŞMA AYARLARI
# ==============================================================================
PORT=3000
SERVER_ENV=production
ALLOWED_ORIGINS=https://app.pagapp.com.tr,https://admin.pagapp.com.tr,https://customer.pagapp.com.tr

# ==============================================================================
# 2. POSTGRESQL VERİTABANI BAĞLANTISI (YALNIZCA GO APİ ERİŞİR)
# ==============================================================================
DATABASE_URL=postgres://pag_user:YOUR_STRONG_PASSWORD@127.0.0.1:5432/pag_prod?sslmode=disable

# Bağlantı Havuzu (Connection Pool):
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_TIME_MINUTES=15

# ==============================================================================
# 3. CLOUDFLARE R2 (S3 UYUMLU MEDYA VE GÖRSEL DEPOLAMA)
# ==============================================================================
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=CLOUDFLARE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CLOUDFLARE_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=netadisyon
R2_PUBLIC_DOMAIN=https://cdn.netadisyon.com.tr
R2_UPLOAD_PREFIX=pag
R2_REGION=auto

# ==============================================================================
# 4. FIREBASE HESAP BİLGİLERİ (YALNIZCA AUTH & FCM PUSH)
# ==============================================================================
FIREBASE_PROJECT_ID=pagwebapp
FIREBASE_MESSAGING_SENDER_ID=1011540629150
FIREBASE_WEB_API_KEY=AIzaSyBNTV8DGRFKNXMne_q4TTH2-HmMNijmlaE
FIREBASE_APP_ID=1:1011540629150:web:34838483b562d9deb5cd8f
FIREBASE_CREDENTIALS_FILE=./serviceAccountKey.json

# ==============================================================================
# 5. PUSH KAMPANYA VE PUAN POLİTİKASI (AGENTS.md)
# ==============================================================================
PUSH_BATCH_SIZE=500
PUSH_BATCH_INTERVAL_SECONDS=60
INITIAL_PHONE_SCORE=200

# ==============================================================================
# 6. WEBSOCKET YAPILANDIRMASI
# ==============================================================================
WS_PING_INTERVAL_SECONDS=30
WS_PONG_TIMEOUT_SECONDS=60
WS_MAX_MESSAGE_SIZE=4096
