rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Clients CANNOT modify profileScore, registeredAt, status, kycStatus, rewardBalance, profileCompleted
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'profileScore', 
          'registeredAt', 
          'status', 
          'kycStatus', 
          'rewardBalance',
          'profileCompleted'
        ]);
        
      allow create, delete: if false; // All creation and deletion managed via trusted backend

      match /profile/current {
        allow read, write: if isOwner(userId);
      }

      // Profile Score Ledger: READ by owner/admin, WRITE prohibited for clients
      match /profileScoreLedgers/{ledgerId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Legal Acceptances: READ/WRITE by owner, READ by admin
      match /legalAcceptances/{acceptanceId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Legal Documents Registry: READ by authenticated users, WRITE by admin
    match /legalDocuments/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Devices Collection Rules
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Device registration updated via trusted backend or owner
      allow write: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // Surveys Collection: READ by authenticated users, WRITE by authorized active portal users
    match /surveys/{surveyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
    }

    // Survey Responses: READ by owner/admin, WRITE strictly prohibited for client SDKs
    match /surveyResponses/{responseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // All writes via Cloud Functions Admin SDK
    }

    // Reward Ledger: READ by owner, WRITE prohibited for clients
    match /rewardLedgers/{ledgerId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /rewardLedger/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Voucher Pools & Vouchers: Restricted
    match /voucherPools/{poolId} {
      allow read: if isOrgMember(resource.data.orgId) || isAdmin();
      allow write: if false;
      
      match /vouchers/{voucherId} {
        allow read: if isAuthenticated() && resource.data.assignedUserId == request.auth.uid;
        allow write: if false;
      }
    }

    // Organization Data: Enforces Tenant Isolation
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isAdmin();
      allow write: if isAdmin();
      
      match /members/{memberId} {
        allow read: if isOrgMember(orgId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Portal Users Rules: Users can read their own portalUser record and update mustChangePassword
    match /portalUsers/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']);
      allow write: if false;
    }

    // Survey & Profile Category Rules
    match /surveyCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
    }

    match /profileSurveyCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
    }

    // Story Bar Collection Rules
    match /storyBar/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
    }

    // Survey Verification Campaigns & Assignments (Quality Verification Module)
    match /surveyVerificationCampaigns/{campaignId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
      allow write: if false; // Managed strictly via Cloud Functions Admin SDK
    }

    match /surveyVerificationAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
      allow write: if false; // All updates via Cloud Functions Admin SDK
    }

    match /verificationCallAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Backend audit logs only
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
